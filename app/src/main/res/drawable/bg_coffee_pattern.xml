<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 1. Deep dark espresso base color -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#1A100C" />
        </shape>
    </item>

    <!-- 2. Coffee pattern background image -->
    <item android:drawable="@drawable/bg_kopi" android:alpha="0.30" />

    <!-- 3. Strong dark brown tone overlay (85% opacity) for a deep, dark, rich coffee mood -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#D91A100C" />
        </shape>
    </item>
</layer-list>
